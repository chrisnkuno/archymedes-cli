{
  "name": "archymedes-cli",
  "version": "0.3.0",
  "private": true,
  "description": "Archymedes CLI monorepo: the Archymedes coding agent, its provider-neutral core, the local state index, and the tooling that builds and releases them.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisnkuno/archymedes-cli.git"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "archymedes": "go run ./cmd/archymedes",
    "dev": "go run ./cmd/archymedes",
    "agent": "bun run packages/archymedes-cli/src/archymedes.ts",
    "check": "bun run test && bun run test:go && bun run typecheck && bun run build:packages",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "bun run tooling/live/provider-smoke.ts",
    "test:invariants": "vitest run packages/core/src/runtime-invariants.test.ts packages/core/src/providers/chat-dialects.test.ts packages/core/src/tool-aliases.test.ts && go test ./internal/tui -run 'Invariants|EveryAppHolds|PureFunction|Wallpaper|Glass|Glyph' -count=1",
    "typecheck": "tsc --noEmit",
    "build:cli": "bun run tooling/build/build-cli.ts",
    "build:packages": "bun run tooling/build/build-packages.ts",
    "build:state": "cargo build --release --manifest-path packages/archymedes-state/Cargo.toml --bin archymedes-state",
    "test:state": "cargo test --manifest-path packages/archymedes-state/Cargo.toml",
    "bench:state": "cargo run --release --features benchmark --manifest-path packages/archymedes-state/Cargo.toml --bin archymedes-state-bench -- --sessions 500 --messages 40 --queries 200",
    "bench:defender": "cargo run --release --features benchmark --manifest-path packages/archymedes-state/Cargo.toml --bin archymedes-defender-brain-bench -- --records 10000 --queries 2000",
    "bench:render": "bun run benchmarks/render/hot-paths.bench.ts",
    "bench:speed": "bun run benchmarks/speed/speed.bench.ts",
    "bench:speed:go": "go test -run xxx -bench . -benchtime 200x ./internal/tui",
    "verify:package": "bun run tooling/build/build-go.ts --host && bun run tooling/build/verify-package.ts",
    "release:check": "bun run check && bun run verify:package",
    "recheck": "bun run tooling/check/recheck.ts",
    "build:go": "bun run tooling/build/build-go.ts",
    "test:go": "go test ./..."
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "@xterm/headless": "5.5.0",
    "e2b": "^2.39.0",
    "node-pty": "^1.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
