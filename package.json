{
  "name": "archymedes-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Archymedes CLI monorepo: the Archymedes coding agent, its provider-neutral core, the local state index, and the tooling that builds and releases them.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisnkuno/archymedes-cli.git"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "archymedes": "bun run packages/archymedes-cli/src/archymedes.ts",
    "check": "bun run test && bun run typecheck && bun run build:packages",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build:cli": "bun run tooling/build/build-cli.ts",
    "build:packages": "bun run tooling/build/build-packages.ts",
    "build:state": "cargo build --release --manifest-path packages/archymedes-state/Cargo.toml --bin archymedes-state",
    "test:state": "cargo test --manifest-path packages/archymedes-state/Cargo.toml",
    "bench:state": "cargo run --release --features benchmark --manifest-path packages/archymedes-state/Cargo.toml --bin archymedes-state-bench -- --sessions 500 --messages 40 --queries 200",
    "bench:defender": "cargo run --release --features benchmark --manifest-path packages/archymedes-state/Cargo.toml --bin archymedes-defender-brain-bench -- --records 10000 --queries 2000"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@termuijs/testing": "^0.1.7",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "e2b": "^2.39.0",
    "node-pty": "^1.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
