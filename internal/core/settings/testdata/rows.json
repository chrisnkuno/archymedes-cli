    "section": "Behaviour",
    "kind": "text"
  },
  {
    "key": "ARCHYMEDES_SANDBOX",
    "label": "Command sandbox (Linux, bubblewrap): commands write only to the project and /tmp",
    "section": "Behaviour",
    "kind": "choice",
    "choices": [
