  {
    "key": "ARCHYMEDES_REASONING",
    "label": "Reasoning effort — clear it to leave each model at its own default",
    "section": "Appearance",
    "kind": "choice",
    "choices": [
      {
        "value": "auto",
        "label": "Auto (experimental) — lower the effort on routine steps, leave hard ones to the model"
      },
      {
        "value": "minimal",
        "label": "Minimal — never think more than needed"
      },
      {
        "value": "low",
        "label": "Low"
      },
      {
        "value": "medium",
        "label": "Medium"
      },
      {
        "value": "high",
        "label": "High"
      },
      {
        "value": "xhigh",
        "label": "Extra high — deeper than high, for hard problems"
      },
      {
        "value": "max",
        "label": "Max — the deepest the model offers, and the slowest"
      }
    ]
  },
  {
    "key": "ARCHYMEDES_RESUME",
    "label": "Continue your last chat at startup",
    "section": "Behaviour",
    "kind": "choice",
    "choices": [
      {
        "value": "ask",
        "label": "Ask — offer to continue the last chat in this folder (default)"
      },
      {
        "value": "always",
        "label": "Always — continue the last chat automatically"
      },
      {
        "value": "never",
        "label": "Never — always start fresh"
      }
    ]
  },
  {
    "key": "ARCHYMEDES_ENGINE",
    "label": "Engine — what runs your sessions (applies to the next session)",
    "section": "Behaviour",
    "kind": "choice",
    "choices": [
      {
        "value": "go",
        "label": "Go — Friday's engine: background sub-agents, steering, restart-safe sessions (default)"
      },
      {
        "value": "ts",
        "label": "TypeScript — the earlier engine: Codex, sandboxes, /undo, /cost, /review"
      }
    ]
  },
  {
    "key": "ARCHYMEDES_EDITOR_AUTOSAVE",
    "label": "Auto-save in /edit",
    "section": "Behaviour",
    "kind": "choice",
    "choices": [
      {
        "value": "off",
        "label": "Off — save with ctrl+s (default)"
      },
      {
        "value": "on",
        "label": "On — save a second after you stop typing"
      }
    ]
  },
  {
    "key": "ARCHYMEDES_SUGGEST",
    "label": "Suggestions — next steps, notes on edits, hints while typing",
    "section": "Behaviour",
    "kind": "choice",
    "choices": [
      {
        "value": "on",
        "label": "On — next steps after a turn, notes on edits, hints while typing (default)"
      },
      {
        "value": "off",
        "label": "Off — no suggestions"
      }
    ]
  },
  {
    "key": "ARCHYMEDES_SUGGEST_MODEL",
    "label": "Ask the model for extra suggestions (a small extra call per turn)",
    "section": "Behaviour",
    "kind": "choice",
    "choices": [
      {
        "value": "off",
        "label": "Off — rule-based suggestions only"
      },
      {
        "value": "on",
        "label": "On — the model may add up to two more"
      }
    ]
  },
  {
    "key": "ARCHYMEDES_NOTIFY",
    "label": "Notifications — when a turn ends or Friday waits for you",
    "section": "Behaviour",
    "kind": "choice",
    "choices": [
      {
        "value": "auto",
        "label": "Auto — only while the terminal is not focused (default)"
      },
      {
        "value": "always",
        "label": "Always — even while you are looking"
      },
      {
        "value": "off",
        "label": "Off — no notifications"
      }
    ]
  },
  {
    "key": "ARCHYMEDES_NOTIFY_URL",
    "label": "Push URL for notifications, such as https://ntfy.sh/your-topic (event and folder name only)",
    "section": "Behaviour",
    "kind": "text"
  },
  {
    "key": "ARCHYMEDES_AUTO_UPDATE",
    "label": "Automatic updates — install daily by default",
    "section": "Behaviour",
    "kind": "choice",
    "choices": [
      {
        "value": "install",
        "label": "Check daily and install automatically (default)"
      },
      {
        "value": "check",
        "label": "Check daily and tell me only"
      },
      {
        "value": "off",
        "label": "Never check"
      }
    ]
  },
  {
    "key": "ARCHYMEDES_TELEMETRY",
    "label": "Install count — one anonymous cue per new version (event, version, OS)",
    "section": "Behaviour",
    "kind": "choice",
    "choices": [
      {
        "value": "on",
        "label": "On — one anonymous cue when a new version first runs (default)"
      },
      {
        "value": "off",
        "label": "Off — nothing is sent"
      }
    ]
  },
  {
    "key": "ARCHYMEDES_TEST_FIRST",
    "label": "Build test first — tests, then code, then static analysis",
    "section": "Behaviour",
    "kind": "choice",
    "choices": [
      {
        "value": "on",
        "label": "On — tests that define done, then the code, then a light static check (default)"
      },
      {
        "value": "off",
        "label": "Off — verify with whatever the change needs"
      }
    ]
  },
  {
    "key": "ARCHYMEDES_JEV",
    "label": "Jev second opinion — verdicts, tool checks, ranked suggestions",
    "section": "Behaviour",
    "kind": "choice",
    "choices": [
      {
        "value": "on",
        "label": "On — judge turns, suggestions and edits when TYPESAFE_API_KEY is set (default)"
      },
      {
        "value": "off",
        "label": "Off — never call Jev, even with a key configured"
      }
    ]
  },
  {
    "key": "ARCHYMEDES_KEYS",
